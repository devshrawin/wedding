# ── Core ─────────────────────────────────────────────────────────────
# Long random string used to sign sessions. REQUIRED in production.
AUTH_SECRET=
# Public origin of the deployment, e.g. https://giftr.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
# Postgres connection string (Supabase: Project Settings → Database → URI).
# Leave empty to use the embedded PGlite database stored in ./.data
DATABASE_URL=

# ── Phone OTP ────────────────────────────────────────────────────────
# With no SMS provider the app runs in demo mode and shows the OTP on screen.
# Demo mode is automatic in development; in production it must be opted into.
DEMO_MODE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Razorpay (optional) ──────────────────────────────────────────────
# When set, guests can also pay through Razorpay checkout (UPI, cards, netbanking).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Platform fee on Razorpay contributions, in percent.
PLATFORM_FEE_PERCENT=2.5
